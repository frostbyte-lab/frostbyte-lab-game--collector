    "test:api-replay": "node tests/api-replay.test.mjs",
    "test:realtime": "node tests/realtime-adapter.test.mjs",
    "test:runtime-interceptor": "node tests/runtime-interceptor.test.mjs",
    "test:package-readiness": "node tests/package-readiness.test.mjs",
    "test:collect-artifact": "node tests/collect-artifact-schema.test.mjs",
    "test:collect-signed-assets": "node tests/collect-signed-assets.test.mjs",
    "test:manus-api": "node tests/manus-api.test.mjs",
    "test:collect-ai-assistant": "node tests/collect-ai-assistant.test.mjs",
