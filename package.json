    "test:unit": "node --test tests/*.mjs",
    "check:inline-js": "node scripts/check-inline-js.cjs",
    "test:offline": "node tests/offline-sw.test.mjs",
    "test:stateful-api": "node tests/stateful-api.test.mjs",
